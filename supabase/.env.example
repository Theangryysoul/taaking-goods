# SERVER ONLY. Set these with Supabase secrets, not in Vite or Git.
# Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to deployed functions.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated exact browser origins; no wildcard and no trailing slash.
# Include only origins you control. Remove localhost from production when done.
CATALOG_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
