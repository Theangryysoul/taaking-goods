# Public browser configuration. Copy to .env.local, fill in, and restart Vite.
# Never put a Supabase service-role key or Cloudinary secret in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# A legacy public anon JWT may be used instead of the publishable key:
# VITE_SUPABASE_ANON_KEY=
